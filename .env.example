# Copy to .env and fill in. Never commit the real file.

# Optional. Without it the system runs in policy-fallback mode: every
# decision is made by the deterministic policy engine instead of the model,
# and the evaluation suite still passes 10/10. Set it to see LLM reasoning.
ANTHROPIC_API_KEY=

# Model used for both the decider and the LLM judge.
ANTHROPIC_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=2000

# SQLite by default. Point at Postgres if you prefer.
DATABASE_URL=sqlite:///./purchasing.db

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Frontend -> backend base URL.
VITE_API_BASE=http://localhost:8000
